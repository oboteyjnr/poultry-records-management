# ── Supabase configuration ────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API.
#
# VITE_* variables are bundled into the browser. Only ever put the publishable /
# anon key here — Row Level Security is what protects the data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ── Optional: CLI access for `supabase db push` / migrations ──────────────────
# Not read by the app; used by the Supabase CLI when linking/pushing migrations.
# DATABASE_URL=postgresql://postgres:<password>@db.your-project-ref.supabase.co:5432/postgres